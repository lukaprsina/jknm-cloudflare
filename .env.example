# drizzle-kit only (direct Supabase host); never reaches the Worker.
DATABASE_URL=
# Local Hyperdrive origin for `vp dev`; `<BINDING>` is the binding name.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
# Inlined at build time: must be set in CI and any build environment.
NEXT_PUBLIC_DEPLOYMENT_ORIGIN=
# Worker secrets for `vp dev` / `vp preview` live in .dev.vars, not here (preview
# does not read .env): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
# Deployed, set them with `cf`. Prod values are in .env.prod-ref.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
